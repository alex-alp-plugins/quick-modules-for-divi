msgid "Favorites"
msgstr "Ulubione"

msgid "Recent"
msgstr "Ostatnie"

msgid "No favorites yet. Click a star to add one."
msgstr "Nie ma jeszcze ulubionych. Kliknij gwiazdkę, aby dodać moduł."

msgid "Recently used modules will appear here."
msgstr "Ostatnio używane moduły pojawią się tutaj."

msgid "Add to favorites"
msgstr "Dodaj do ulubionych"

msgid "Remove from favorites"
msgstr "Usuń z ulubionych"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s dodano do Ulubionych."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s usunięto z Ulubionych."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "Usuń %s z ulubionych"

msgid "Drag to reorder"
msgstr "Przeciągnij, aby zmienić kolejność"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "Nie można znaleźć %s na bieżącej liście modułów."
