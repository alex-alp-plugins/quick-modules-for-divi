msgid "Favorites"
msgstr "Favoritos"

msgid "Recent"
msgstr "Recientes"

msgid "No favorites yet. Click a star to add one."
msgstr "Aún no hay favoritos. Haz clic en una estrella para agregar uno."

msgid "Recently used modules will appear here."
msgstr "Los módulos usados recientemente aparecerán aquí."

msgid "Add to favorites"
msgstr "Agregar a favoritos"

msgid "Remove from favorites"
msgstr "Quitar de favoritos"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s se agregó a Favoritos."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s se quitó de Favoritos."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "Quitar %s de favoritos"

msgid "Drag to reorder"
msgstr "Arrastra para reordenar"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "No se pudo encontrar %s en la lista actual de módulos."
