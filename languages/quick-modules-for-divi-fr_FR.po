msgid "Favorites"
msgstr "Favoris"

msgid "Recent"
msgstr "Récents"

msgid "No favorites yet. Click a star to add one."
msgstr "Aucun favori pour le moment. Cliquez sur une étoile pour en ajouter un."

msgid "Recently used modules will appear here."
msgstr "Les modules utilisés récemment apparaîtront ici."

msgid "Add to favorites"
msgstr "Ajouter aux favoris"

msgid "Remove from favorites"
msgstr "Retirer des favoris"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s a été ajouté aux Favoris."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s a été retiré des Favoris."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "Retirer %s des favoris"

msgid "Drag to reorder"
msgstr "Faites glisser pour réorganiser"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "Impossible de trouver %s dans la liste actuelle des modules."
