msgid "Favorites"
msgstr "Preferiti"

msgid "Recent"
msgstr "Recenti"

msgid "No favorites yet. Click a star to add one."
msgstr "Non ci sono ancora preferiti. Fai clic su una stella per aggiungerne uno."

msgid "Recently used modules will appear here."
msgstr "I moduli usati di recente verranno visualizzati qui."

msgid "Add to favorites"
msgstr "Aggiungi ai preferiti"

msgid "Remove from favorites"
msgstr "Rimuovi dai preferiti"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s è stato aggiunto ai Preferiti."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s è stato rimosso dai Preferiti."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "Rimuovi %s dai preferiti"

msgid "Drag to reorder"
msgstr "Trascina per riordinare"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "Impossibile trovare %s nell’elenco corrente dei moduli."
