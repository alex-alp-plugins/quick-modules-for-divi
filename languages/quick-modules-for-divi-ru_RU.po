msgid "Favorites"
msgstr "Избранное"

msgid "Recent"
msgstr "Недавние"

msgid "No favorites yet. Click a star to add one."
msgstr "Пока нет избранных. Нажмите на звезду, чтобы добавить модуль."

msgid "Recently used modules will appear here."
msgstr "Недавно использованные модули появятся здесь."

msgid "Add to favorites"
msgstr "Добавить в избранное"

msgid "Remove from favorites"
msgstr "Удалить из избранного"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s добавлен в Избранное."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s удалён из Избранного."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "Удалить %s из избранного"

msgid "Drag to reorder"
msgstr "Перетащите, чтобы изменить порядок"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "Не удалось найти %s в текущем списке модулей."
