msgid "Favorites"
msgstr "Favoriten"

msgid "Recent"
msgstr "Zuletzt verwendet"

msgid "No favorites yet. Click a star to add one."
msgstr "Noch keine Favoriten. Klicke auf einen Stern, um einen hinzuzufügen."

msgid "Recently used modules will appear here."
msgstr "Zuletzt verwendete Module werden hier angezeigt."

msgid "Add to favorites"
msgstr "Zu Favoriten hinzufügen"

msgid "Remove from favorites"
msgstr "Aus Favoriten entfernen"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "%s wurde zu den Favoriten hinzugefügt."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "%s wurde aus den Favoriten entfernt."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "%s aus Favoriten entfernen"

msgid "Drag to reorder"
msgstr "Zum Neuordnen ziehen"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "%s konnte in der aktuellen Modulliste nicht gefunden werden."
