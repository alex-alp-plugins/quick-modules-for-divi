msgid "Favorites"
msgstr "المفضلة"

msgid "Recent"
msgstr "المستخدمة مؤخرًا"

msgid "No favorites yet. Click a star to add one."
msgstr "لا توجد عناصر مفضلة بعد. انقر على نجمة لإضافة عنصر."

msgid "Recently used modules will appear here."
msgstr "ستظهر الوحدات المستخدمة مؤخرًا هنا."

msgid "Add to favorites"
msgstr "إضافة إلى المفضلة"

msgid "Remove from favorites"
msgstr "إزالة من المفضلة"

#. translators: %s: Divi module name.
msgid "%s added to Favorites."
msgstr "تمت إضافة %s إلى المفضلة."

#. translators: %s: Divi module name.
msgid "%s removed from Favorites."
msgstr "تمت إزالة %s من المفضلة."

#. translators: %s: Divi module name.
msgid "Remove %s from favorites"
msgstr "إزالة %s من المفضلة"

msgid "Drag to reorder"
msgstr "اسحب لإعادة الترتيب"

#. translators: %s: Divi module name.
msgid "Could not find %s in the current module list."
msgstr "تعذر العثور على %s في قائمة الوحدات الحالية."
